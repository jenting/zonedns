# Central side: CoreDNS + plugin/zonedns.
#
# CoreDNS plugins are linked at compile time with no runtime loading mechanism, so
# the host binary has to be rebuilt. The build context is the repo root.
#
#   docker build -f build/Dockerfile.central -t zonedns-central:dev .

ARG GO_VERSION=1.25
ARG COREDNS_VERSION=v1.14.6

FROM golang:${GO_VERSION} AS builder
ARG COREDNS_VERSION

RUN git clone -q --depth 1 --branch ${COREDNS_VERSION} \
      https://github.com/coredns/coredns.git /src/coredns

# This repo is private and go get cannot reach it from inside the container, so a
# replace points at the source copied in above.
COPY . /src/zonedns
WORKDIR /src/coredns
RUN go mod edit -replace github.com/jenting/zonedns=/src/zonedns && \
    go mod edit -require github.com/jenting/zonedns@v0.0.0

# zonedns must sort before cache or the plugin's setup() refuses to start: the
# built-in cache keys on (qname, qtype) and does not include the asking workload's
# zone.
RUN sed -i 's|^cache:cache$|zonedns:github.com/jenting/zonedns/plugin/zonedns\ncache:cache|' plugin.cfg && \
    grep -q '^zonedns:' plugin.cfg

# The order matters: go generate writes the import first, so that go mod tidy does
# not drop the require.
RUN go generate && go mod tidy && \
    CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/coredns .

# Verify right after building, so a failure stops at build time rather than at
# deployment.
RUN /out/coredns -plugins | grep -qx zonedns

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/coredns /usr/local/bin/coredns
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/coredns"]
