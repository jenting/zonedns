# Node side: sigs.k8s.io/node-local-dns + plugin/zonedns_agent.
#
# The host is not ordinary CoreDNS but node-local-dns, which additionally manages
# a dummy interface and iptables rules — the premise on which the link-local
# address works at all.
#
# Two steps here are not obvious and break the build by their absence:
#   1. node-local-dns vendors its dependencies into the repo, so this needs
#      go mod vendor, not go mod tidy
#   2. both the vendoring and the build must use GOOS=linux — vendoring on another
#      platform omits the linux-only k8s.io/kubernetes/pkg/util/iptables, and the
#      symptom is a run of undefined: utiliptables.* that looks like a version
#      conflict when the vendor tree is simply missing that platform's files
#
#   docker build -f build/Dockerfile.agent -t zonedns-agent:dev .

ARG GO_VERSION=1.25
# Pinned to the version upstream kubernetes/kubernetes's nodelocaldns addon
# manifest currently uses, so the self-built image belongs to the same generation
# as upstream's deployment. Note that the default branch is master, not main.
ARG NODE_LOCAL_DNS_REF=1.26.8

FROM golang:${GO_VERSION} AS builder
ARG NODE_LOCAL_DNS_REF
ARG TARGETARCH

RUN git clone -q --depth 1 --branch ${NODE_LOCAL_DNS_REF} \
      https://github.com/kubernetes-sigs/node-local-dns.git /src/node-local-dns

COPY . /src/zonedns
WORKDIR /src/node-local-dns

# Adding a file rather than editing main.go: its own init() performs the blank
# import and the Directives insertion. Sed-ing upstream's source would fail
# silently the moment upstream reformats — the build still succeeds, the binary
# simply has no plugin in it.
# Strip the ignore tag: in this repo it excludes a package main with no main
# function, and here the file must take part in the build.
COPY build/zonedns_register.go /tmp/zonedns_register.go
RUN grep -v '^//go:build ignore$' /tmp/zonedns_register.go > cmd/node-cache/zonedns_register.go && \
    grep -q 'zonedns_agent' cmd/node-cache/zonedns_register.go

# tidy must come before vendor: this module brings in dependencies upstream's
# go.mod does not have (go-spiffe, golang-lru and others), and without tidying
# first, vendor fails with "updates to go.mod needed".
RUN go mod edit -replace github.com/jenting/zonedns=/src/zonedns && \
    go mod edit -require github.com/jenting/zonedns@v0.0.0 && \
    go mod tidy && \
    GOOS=linux go mod vendor

RUN GOOS=linux GOARCH=${TARGETARCH:-amd64} CGO_ENABLED=0 \
      go build -ldflags="-s -w" -o /out/node-cache ./cmd/node-cache

# node-local-dns has no -plugins flag, so the check instead feeds it a Corefile
# containing zonedns_agent and confirms it parses. With the configuration
# incomplete it stops while fetching an SVID, which already proves the directive
# was recognised — had the plugin not been linked in, the error would be Unknown
# directive.
RUN printf 'example.com:53 {\n zonedns_agent {\n  mode vm\n  zone zone-a\n  upstream https://central.invalid\n  central_spiffe_id spiffe://example.org/c\n  workload_api unix:///nonexistent.sock\n }\n}\n' > /tmp/Corefile && \
    /out/node-cache -localip 169.254.20.10 -conf /tmp/Corefile \
      -setupinterface=false -setupiptables=false -skipteardown 2>&1 \
      | tee /tmp/out.log; \
    grep -q "Unknown directive" /tmp/out.log && { echo "the plugin was not linked in"; exit 1; } || true

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/node-cache /usr/local/bin/node-cache
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/node-cache"]
